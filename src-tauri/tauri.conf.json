{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Extractr",
  "version": "0.2.5",
  "identifier": "com.extractr.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Extractr",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["zip"], "name": "ZIP Archive", "description": "ZIP Archive", "role": "Viewer", "mimeType": "application/zip", "contentTypes": ["com.pkware.zip-archive"] },
      { "ext": ["7z"], "name": "7z Archive", "description": "7z Archive", "role": "Viewer", "mimeType": "application/x-7z-compressed", "contentTypes": ["org.7-zip.7z-archive"] },
      { "ext": ["rar"], "name": "RAR Archive", "description": "RAR Archive", "role": "Viewer", "mimeType": "application/x-rar-compressed", "contentTypes": ["com.rarlab.rar-archive"] },
      { "ext": ["tar"], "name": "TAR Archive", "description": "TAR Archive", "role": "Viewer", "mimeType": "application/x-tar", "contentTypes": ["public.tar-archive"] },
      { "ext": ["gz", "gzip"], "name": "GZIP Archive", "description": "GZIP Archive", "role": "Viewer", "mimeType": "application/gzip", "contentTypes": ["org.gnu.gnu-zip-archive"] },
      { "ext": ["bz2"], "name": "BZIP2 Archive", "description": "BZIP2 Archive", "role": "Viewer", "mimeType": "application/x-bzip2", "contentTypes": ["public.bzip2-archive"] },
      { "ext": ["xz"], "name": "XZ Archive", "description": "XZ Archive", "role": "Viewer", "mimeType": "application/x-xz", "contentTypes": ["org.tukaani.xz-archive"] },
      { "ext": ["zst", "zstd"], "name": "Zstandard Archive", "description": "Zstandard Archive", "role": "Viewer", "mimeType": "application/zstd", "contentTypes": ["com.facebook.zstd-archive"] },
      { "ext": ["tgz", "tbz2", "txz", "tzst"], "name": "Compressed TAR", "description": "Compressed TAR Archive", "role": "Viewer", "mimeType": "application/gzip" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "nsis/installer.nsh"
      },
      "wix": { "language": ["en-US", "zh-CN"] }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}
