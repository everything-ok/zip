{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Extractr",
  "version": "0.2.5",
  "identifier": "com.extractr.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Extractr",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["zip"], "name": "ZIP Archive", "description": "ZIP Archive" },
      { "ext": ["7z"], "name": "7z Archive", "description": "7z Archive" },
      { "ext": ["rar"], "name": "RAR Archive", "description": "RAR Archive" },
      { "ext": ["tar"], "name": "TAR Archive", "description": "TAR Archive" },
      { "ext": ["gz", "gzip"], "name": "GZIP Archive", "description": "GZIP Archive" },
      { "ext": ["bz2"], "name": "BZIP2 Archive", "description": "BZIP2 Archive" },
      { "ext": ["xz"], "name": "XZ Archive", "description": "XZ Archive" },
      { "ext": ["zst", "zstd"], "name": "Zstandard Archive", "description": "Zstandard Archive" },
      { "ext": ["tgz", "tbz2", "txz", "tzst"], "name": "Compressed TAR", "description": "Compressed TAR Archive" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "nsis/installer.nsh"
      },
      "wix": { "language": ["en-US", "zh-CN"] }
    }
  }
}
